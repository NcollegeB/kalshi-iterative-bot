# Store this file at /etc/kalshi-bot/kalshi-bot.env with mode 600.
KALSHI_ENV=production
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/etc/kalshi-bot/kalshi-private-key.pem
KALSHI_PRIVATE_KEY_PEM=

# Keep paper_only until live-ready succeeds on the server.
KALSHI_ALLOW_LIVE=paper_only

BOT_BANKROLL_DOLLARS=20.00
BOT_MAX_POSITION_DOLLARS=4.00
BOT_MAX_OPEN_RISK_DOLLARS=5.00
BOT_DAILY_LOSS_LIMIT_DOLLARS=2.00
BOT_MIN_EDGE_DOLLARS=0.08
BOT_ALLOWED_ASSETS=BTC,ETH,SOL
BOT_MAX_SPREAD_DOLLARS=0.02
BOT_MIN_TIME_TO_CLOSE_MINUTES=10
BOT_MAX_TIME_TO_CLOSE_MINUTES=60
BOT_MAX_BANKROLL_FRACTION_PER_TRADE=0.20
BOT_KELLY_FRACTION=0.25

BOT_ADAPTIVE_RISK_ENABLED=false
BOT_ADAPTIVE_MIN_SETTLED_TRADES=20
BOT_ADAPTIVE_WINDOW_TRADES=50
BOT_ADAPTIVE_STEP_UP=0.15
BOT_ADAPTIVE_STEP_DOWN=0.25
BOT_ADAPTIVE_MIN_MULTIPLIER=0.50
BOT_ADAPTIVE_MAX_MULTIPLIER=1.25
BOT_ADAPTIVE_MAX_BRIER_SCORE=0.25
BOT_ADAPTIVE_MAX_LOG_LOSS=0.75
BOT_ADAPTIVE_MAX_DRAWDOWN_DOLLARS=4.00

BOT_CALIBRATION_ENABLED=false
BOT_CALIBRATION_MIN_SAMPLES=20
BOT_CALIBRATION_WINDOW_TRADES=200
BOT_CALIBRATION_STRENGTH=0.35
BOT_CALIBRATION_MAX_ADJUSTMENT=0.10

BOT_PERFORMANCE_GUARD_ENABLED=false
BOT_PERFORMANCE_GUARD_MIN_TRADES=20
BOT_PERFORMANCE_GUARD_WINDOW_TRADES=100
BOT_PERFORMANCE_GUARD_MIN_NET_PNL_DOLLARS=0.00
BOT_PERFORMANCE_GUARD_MIN_AVG_CLV=0.00
BOT_PERFORMANCE_GUARD_START_AT=
BOT_MAX_LIVE_CORRELATED_ORDERS_PER_SCAN=1
BOT_CORRELATION_TIME_BUCKET_MINUTES=5

BOT_SLIPPAGE_BASE_DOLLARS=0.01
BOT_SLIPPAGE_SPREAD_FACTOR=0.25
BOT_ORDERFLOW_ENABLED=true
BOT_ORDERFLOW_LOOKBACK_MINUTES=30
BOT_ORDERFLOW_MIN_TRADES=3
BOT_ORDERFLOW_MIN_CONTRACTS=20
BOT_ORDERFLOW_LARGE_TRADE_CONTRACTS=25
BOT_ORDERFLOW_MAX_PROBABILITY_ADJUSTMENT=0.04
