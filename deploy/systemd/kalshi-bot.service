[Unit]
Description=Kalshi iterative trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kalshi
Group=kalshi
WorkingDirectory=/opt/kalshi-bot
EnvironmentFile=/etc/kalshi-bot/kalshi-bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kalshi-bot/.venv/bin/kalshi-bot loop --interval-seconds 60 --refresh-crypto --enable-live-buys --execute-exits --profit-pct 100
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/kalshi-bot
ReadWritePaths=/opt/kalshi-bot/data /opt/kalshi-bot/logs

[Install]
WantedBy=multi-user.target
