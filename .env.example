# Copy to .env and fill in only when you need authenticated demo/live endpoints.
# Public market-data scans do not require credentials.

# production or demo
KALSHI_ENV=production

# API key ID shown in Kalshi account settings.
KALSHI_API_KEY_ID=

# Prefer a private-key file path. Do not commit the key file.
KALSHI_PRIVATE_KEY_PATH=

# Optional alternative for local experiments. Avoid storing PEM text in shell history.
KALSHI_PRIVATE_KEY_PEM=

# Live trading requires both --live and this exact opt-in value.
KALSHI_ALLOW_LIVE=paper_only

# Bankroll/risk defaults for a $20 tranche.
BOT_BANKROLL_DOLLARS=20.00
BOT_MAX_POSITION_DOLLARS=1.00
BOT_MAX_OPEN_RISK_DOLLARS=5.00
BOT_DAILY_LOSS_LIMIT_DOLLARS=2.00
BOT_MIN_EDGE_DOLLARS=0.08
BOT_MAX_BANKROLL_FRACTION_PER_TRADE=0.10
BOT_KELLY_FRACTION=0.25

# Adaptive sizing from recent realized/settled results.
BOT_ADAPTIVE_RISK_ENABLED=true
BOT_ADAPTIVE_MIN_SETTLED_TRADES=20
BOT_ADAPTIVE_WINDOW_TRADES=50
BOT_ADAPTIVE_STEP_UP=0.15
BOT_ADAPTIVE_STEP_DOWN=0.25
BOT_ADAPTIVE_MIN_MULTIPLIER=0.50
BOT_ADAPTIVE_MAX_MULTIPLIER=1.25
BOT_ADAPTIVE_MAX_BRIER_SCORE=0.25
BOT_ADAPTIVE_MAX_LOG_LOSS=0.75
BOT_ADAPTIVE_MAX_DRAWDOWN_DOLLARS=4.00
